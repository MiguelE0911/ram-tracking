<UserControl x:Class="RamTracking.Controls.SlotMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:RamTracking.Models;assembly=RamTracking"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <TextBlock Text="Mapa de Slots de Memoria"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="#1F2937" Margin="8"
                   Grid.Row="0"/>

        <!-- Contenedor de módulos -->
        <ItemsControl ItemsSource="{Binding SlotModules}"
                      Grid.Row="1"
                      Margin="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- Plantilla de módulo -->
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4"
                            Margin="2" MinWidth="140" MinHeight="100">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EFF6FF" Offset="0"/>
                                <GradientStop Color="#DBEAFE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="8" VerticalAlignment="Stretch">
                            <TextBlock Text="{Binding BankDisplay}" FontWeight="Bold"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CapacityDisplay}" FontSize="10"
                                       Foreground="#1E3A8A" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding MemoryTypeDisplay}" FontSize="9"
                                       Foreground="#64748B" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding SpeedDisplay}" FontSize="9"
                                       Foreground="#059669" Margin="0,0,0,1"/>
                            <TextBlock Text="{Binding FormFactorDisplay}" FontSize="8"
                                       Foreground="#9CA3AF" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding PartNumberDisplay}" FontSize="8"
                                       Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

            <!-- Plantilla de vacío -->
            <ItemsControl.Template>
                <ControlTemplate>
                    <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </ItemsControl.Template>
        </ItemsControl>
    </Grid>

    <UserControl.Resources>
        <!-- Plantilla para un módulo de memoria -->
        <DataTemplate x:Key="MemoryModuleTemplate">
            <Border BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4"
                    Margin="2" MinWidth="140" MinHeight="100">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#EFF6FF" Offset="0"/>
                        <GradientStop Color="#DBEAFE" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="8" VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding BankDisplay}" FontWeight="Bold"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding CapacityDisplay}" FontSize="10"
                               Foreground="#1E3A8A" Margin="0,0,0,1"/>
                    <TextBlock Text="{Binding MemoryTypeDisplay}" FontSize="9"
                               Foreground="#64748B" Margin="0,0,0,1"/>
                    <TextBlock Text="{Binding SpeedDisplay}" FontSize="9"
                               Foreground="#059669" Margin="0,0,0,1"/>
                    <TextBlock Text="{Binding FormFactorDisplay}" FontSize="8"
                               Foreground="#9CA3AF" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding PartNumberDisplay}" FontSize="8"
                               Foreground="#64748B"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Plantilla para estado vacío -->
        <DataTemplate x:Key="EmptyStateTemplate">
            <TextBlock Text="No hay módulos de memoria detectados"
                       Foreground="#6B7280" FontStyle="Italic"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Margin="20"/>
        </DataTemplate>
    </UserControl.Resources>
</UserControl>