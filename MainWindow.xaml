<Window x:Class="RamTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:RamTracking"
        xmlns:conv="clr-namespace:RamTracking.Converters"
        xmlns:vm="clr-namespace:RamTracking.ViewModels"
        mc:Ignorable="d"
        Title="Ram Tracking - Diagnóstico de Memoria RAM"
        Height="850" Width="1100"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:DesignTimeViewModel, IsDesignTimeCreatable=True}">
    
    <Window.Resources>
        <conv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        
        <!-- Estilos comunes -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#212121"/>
        </Style>

        <Style x:Key="UnitTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="TabHeaderStyle" TargetType="TabItem">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#424242"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,3"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1976D2"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Header -->
            <RowDefinition Height="Auto"/>    <!-- Tarjetas + Barra utilización -->
            <RowDefinition Height="*"/>       <!-- TabControl con contenido -->
            <RowDefinition Height="Auto"/>    <!-- Botones principales (siempre visibles) -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Nombre -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ram Tracking" FontSize="24" FontWeight="Bold" Foreground="#1976D2"/>
                        <TextBlock Text="Diagnóstico de Memoria RAM" FontSize="12" Foreground="#757575"/>
                    </StackPanel>
                </StackPanel>

                <!-- Info del equipo -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemInfo.ComputerName}" FontSize="16" FontWeight="Medium" Foreground="#333333"/>
                    <TextBlock Text="{Binding SystemInfo.OperatingSystem}" FontSize="11" Foreground="#757575"/>
                </StackPanel>

                <!-- CPU / Arquitectura -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemInfo.Processor}" FontSize="11" Foreground="#757575" TextAlignment="Right"/>
                    <TextBlock Text="{Binding SystemInfo.Architecture}" FontSize="11" Foreground="#757575" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TARJETAS DE MEMORIA + BARRA UTILIZACIÓN (Siempre visibles) ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjetas de memoria (4 columnas) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Instalada" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{Binding MemoryCards[0].Value, StringFormat='{}{0:F2}'}" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Text="GiB" Style="{StaticResource UnitTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Utilizable" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{Binding MemoryCards[1].Value, StringFormat='{}{0:F2}'}" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Text="GiB" Style="{StaticResource UnitTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="En uso" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{Binding MemoryCards[2].Value, StringFormat='{}{0:F2}'}" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Text="GiB" Style="{StaticResource UnitTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Disponible" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock Text="{Binding MemoryCards[3].Value, StringFormat='{}{0:F2}'}" Style="{StaticResource ValueTextStyle}"/>
                        <TextBlock Text="GiB" Style="{StaticResource UnitTextStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Barra de utilización + Semáforo (columna 5) -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="4,0" Padding="20" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Utilización de memoria" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center"/>

                    <Grid Grid.Row="1" Height="28" Margin="0,8,0,8">
                        <Border Background="#E0E0E0" CornerRadius="14" Height="28"/>
                        <Border Background="{Binding CurrentMemory.UsagePercent, Converter={StaticResource PercentToColorConverter}}"
                                CornerRadius="14" Height="28" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="CurrentMemory.UsagePercent"/>
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <TextBlock Text="{Binding CurrentMemory.UsagePercent, StringFormat='{}{0:F1}%'}" 
                                   FontSize="13" FontWeight="Bold" Foreground="White" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="14" Height="14" Margin="0,0,8,0"
                                 Fill="{Binding CurrentMemory.UsagePercent, Converter={StaticResource PercentToColorConverter}}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentMemory.UsagePercent, Converter={StaticResource PercentToStatusTextConverter}}"
                                   FontSize="13" Foreground="#424242" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== TABCONTROL PRINCIPAL ===== -->
        <TabControl Grid.Row="2" Margin="0,12,0,0" ItemContainerStyle="{StaticResource TabHeaderStyle}">
            <!-- TAB 1: MONITOR -->
            <TabItem Header="📊 Monitor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Gráfica de monitoreo -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Historial de utilización (últimas 60 muestras, actualización cada 2s)" Style="{StaticResource SectionHeaderStyle}"/>

                                <!-- LiveCharts CartesianChart -->
                                <lvc:CartesianChart Grid.Row="1" x:Name="UsageChart" MinHeight="300"
                                                    Series="{Binding ChartSeries}"
                                                    XAxes="{Binding ChartXAxes}"
                                                    YAxes="{Binding ChartYAxes}"
                                                    LegendPosition="Bottom"
                                                    TooltipPosition="Top"
                                                    AnimationsSpeed="0:0:0.2"/>

                                <!-- Stats min/max/avg -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="MÍNIMO" FontSize="11" Foreground="#757575"/>
                                                <TextBlock Text="{Binding MinUsage, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="Bold" Foreground="#4CAF50"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#FFC107" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="PROMEDIO" FontSize="11" Foreground="#757575"/>
                                                <TextBlock Text="{Binding AvgUsage, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="Bold" Foreground="#FFC107"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#F44336" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="MÁXIMO" FontSize="11" Foreground="#757575"/>
                                                <TextBlock Text="{Binding MaxUsage, StringFormat='{}{0:F1}%'}" FontSize="18" FontWeight="Bold" Foreground="#F44336"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Controles de monitoreo -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{Binding IsMonitoring, Converter={StaticResource BoolToMonitorButtonTextConverter}}"
                    Command="{Binding ToggleMonitoringCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="200" Height="48"
                    FontSize="16"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: MÓDULOS -->
            <TabItem Header="🔧 Módulos">
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Módulos de memoria física detectados (vía SMBIOS/WMI)" Style="{StaticResource SectionHeaderStyle}"/>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding Modules}" 
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E0E0E0"
                                  FontSize="13"
                                  AlternatingRowBackground="#FAFAFA"
                                  RowBackground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="🏷 Bank / Slot" Binding="{Binding BankLabel}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="💾 Capacidad" Binding="{Binding CapacityGiB, StringFormat='{}{0:F2} GiB'}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="🏭 Fabricante" Binding="{Binding Manufacturer}" Width="Auto" MinWidth="140"/>
                                <DataGridTextColumn Header="🔢 Número de parte" Binding="{Binding PartNumber}" Width="Auto" MinWidth="180"/>
                                <DataGridTextColumn Header="📦 Tipo" Binding="{Binding MemoryType}" Width="Auto" MinWidth="80"/>
                                <DataGridTextColumn Header="⚡ Velocidad" Binding="{Binding ConfiguredSpeedMTs, StringFormat='{}{0} MT/s'}" Width="Auto" MinWidth="110"/>
                                <DataGridTextColumn Header="🔖 Serie" Binding="{Binding SerialNumber}" Width="Auto" MinWidth="120"/>
                                <DataGridTextColumn Header="📐 Factor forma" Binding="{Binding FormFactor}" Width="Auto" MinWidth="100"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasValidData}" Value="False">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- Mensaje si no hay módulos -->
                        <TextBlock Grid.Row="1" 
                                   Text="No se detectaron módulos (No disponible)" 
                                   FontSize="14" Foreground="#757575" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Modules.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: DIAGNÓSTICO -->
            <TabItem Header="🩺 Diagnóstico">
                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,8,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Diagnóstico y prueba de memoria" Style="{StaticResource SectionHeaderStyle}" FontSize="18"/>

                            <!-- Texto explicativo -->
                            <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DiagnosticText}" 
                                           FontSize="14" Foreground="#2E7D32" 
                                           TextWrapping="Wrap" LineHeight="24"/>
                            </Border>

                            <!-- Observaciones manuales -->
                            <StackPanel Margin="0,24,0,0">
                                <TextBlock Text="📝 Observaciones del usuario" FontSize="15" FontWeight="SemiBold" Foreground="#333333"/>
                                <TextBlock Text="Registre aquí el resultado de la prueba de memoria de Windows (mdsched.exe) u otras notas:" FontSize="12" Foreground="#757575" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding ManualObservation, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="120" Padding="12"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderBrush="#E0E0E0"
                                         BorderThickness="1"
                                         FontSize="14"
                                         Background="#FAFAFA"/>
                            </StackPanel>

                            <!-- Estado prueba -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <TextBlock Text="Estado de la prueba de memoria:" FontSize="13" Foreground="#757575" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding MemoryTestStatusOptions}"
                                          SelectedItem="{Binding MemoryTestStatus}"
                                          Width="220" Margin="12,0,0,0" Padding="8,4"
                                          FontSize="13" VerticalAlignment="Center"
                                          Background="White"/>
                                <Button Content="📋 Copiar instrucciones" 
                                        Command="{Binding CopyDiagnosticCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="16,0,0,0" Padding="16,8" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB 4: REPORTE -->
            <TabItem Header="📄 Reporte">
                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,8,0,0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="Generar reporte de diagnóstico" Style="{StaticResource SectionHeaderStyle}" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="El reporte incluirá:" FontSize="14" Foreground="#424242" Margin="0,16,0,12" TextAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Información del equipo y fecha/hora" FontSize="13" Foreground="#333333"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Memoria instalada, utilizable, en uso, disponible y %" FontSize="13" Foreground="#333333"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Detalle de módulos detectados (fabricante, parte, tipo, MT/s)" FontSize="13" Foreground="#333333"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Estadísticas de monitoreo (mín, máx, promedio)" FontSize="13" Foreground="#333333"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Estado de la prueba de memoria y observaciones" FontSize="13" Foreground="#333333"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Content="📄 Generar reporte TXT"
                                    Command="{Binding GenerateReportCommand}"
                                    CommandParameter="txt"
                                    Style="{StaticResource ActionButtonStyle}"
                                    MinWidth="220" Height="52"
                                    FontSize="15"/>
                            <Button Content="📊 Generar reporte CSV"
                                    Command="{Binding GenerateReportCommand}"
                                    CommandParameter="csv"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="220" Height="52"
                                    Margin="16,0,0,0"
                                    FontSize="15"/>
                        </StackPanel>

                        <TextBlock Text="Se abrirá un diálogo para elegir ubicación y nombre del archivo." 
                                   FontSize="11" Foreground="#9E9E9E" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ===== BOTONES PRINCIPALES (siempre visibles en la parte inferior) ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="{Binding IsMonitoring, Converter={StaticResource BoolToMonitorButtonTextConverter}}"
                    Command="{Binding ToggleMonitoringCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="200" Height="50"
                    FontSize="15" FontWeight="SemiBold"/>
            <Button Content="📄 Generar reporte"
                    Command="{Binding GenerateReportCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="200" Height="50"
                    Margin="16,0,0,0"
                    FontSize="15" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>