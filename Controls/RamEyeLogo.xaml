<UserControl x:Class="RamTracking.Controls.RamEyeLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Logo vectorial: módulo de memoria DIMM con un ojo en el centro.
        Dimensionado por el contenedor (Viewbox mantiene proporciones).
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="48" Height="48">

            <!-- Placa del módulo RAM -->
            <Rectangle Canvas.Left="4" Canvas.Top="14" Width="40" Height="14"
                       RadiusX="2" RadiusY="2"
                       Fill="#14532D"
                       Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.5"/>

            <!-- Pistas del circuito -->
            <Rectangle Canvas.Left="7" Canvas.Top="19" Width="3" Height="6" Fill="#2FBF71" Opacity="0.35"/>
            <Rectangle Canvas.Left="38" Canvas.Top="19" Width="3" Height="6" Fill="#2FBF71" Opacity="0.35"/>

            <!-- Chips de memoria (izquierda y derecha) -->
            <Rectangle Canvas.Left="9" Canvas.Top="17" Width="8" Height="6"
                       RadiusX="1" RadiusY="1" Fill="#1E293B" Stroke="#4ADE80" StrokeThickness="0.8"/>
            <Rectangle Canvas.Left="31" Canvas.Top="17" Width="8" Height="6"
                       RadiusX="1" RadiusY="1" Fill="#1E293B" Stroke="#4ADE80" StrokeThickness="0.8"/>

            <!-- Contactos dorados -->
            <Rectangle Canvas.Left="6" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="9.11" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="12.22" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="15.33" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="18.44" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="21.55" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="24.66" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="27.77" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="30.88" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="33.99" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="37.1" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>
            <Rectangle Canvas.Left="40.21" Canvas.Top="26.5" Width="1.8" Height="4.5" Fill="#C8963E"/>

            <!-- Ojo: esclerótica -->
            <Ellipse Canvas.Left="19" Canvas.Top="16.5" Width="10" Height="7" Fill="#E5E5E5"/>
            <!-- Iris -->
            <Ellipse Canvas.Left="21.8" Canvas.Top="17.8" Width="4.4" Height="4.4" Fill="{DynamicResource PrimaryBrush}"/>
            <!-- Pupila -->
            <Ellipse Canvas.Left="23" Canvas.Top="19" Width="2" Height="2" Fill="#101010"/>
            <!-- Brillo -->
            <Ellipse Canvas.Left="23.4" Canvas.Top="18.5" Width="1" Height="1" Fill="#FFFFFF"/>

        </Canvas>
    </Viewbox>
</UserControl>
