<Window x:Class="RamTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:local="clr-namespace:RamTracking"
        xmlns:controls="clr-namespace:RamTracking.Controls"
        xmlns:conv="clr-namespace:RamTracking.Converters"
        xmlns:vm="clr-namespace:RamTracking.ViewModels"
        mc:Ignorable="d"
        Title="Ram Tracking - Diagnóstico de Memoria RAM"
        Height="850" Width="1100"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:DesignTimeViewModel, IsDesignTimeCreatable=True}">
    
    <Window.Resources>
        <conv:PercentToWidthConverter x:Key="PercentToWidthConverter"/>
        <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <conv:OptionalGiBConverter x:Key="OptionalGiBConverter"/>
        <conv:OptionalVoltageConverter x:Key="OptionalVoltageConverter"/>
        <conv:NotAvailableTextConverter x:Key="NotAvailableTextConverter"/>
        <conv:SectionVisibilityConverter x:Key="SectionVisibilityConverter"/>
        <conv:OptionalPercentTextConverter x:Key="OptionalPercentTextConverter"/>
        <conv:MenuWidthConverter x:Key="MenuWidthConverter"/>
        <conv:OptionalSlotsConverter x:Key="OptionalSlotsConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Estilos comunes -->
        <Style x:Key="CardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="UnitTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>

        <!-- Tarjeta de memoria reutilizable (4 tarjetas superiores) -->
        <DataTemplate x:Key="MemoryCardTemplate">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Label}" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" FontSize="12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="{Binding DisplayValue}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="FontSize" Value="15"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource UnitTextStyle}"
                               Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Ítem del menú lateral -->
        <Style x:Key="MenuItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,10" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5"
                                        Background="{DynamicResource PrimaryBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-8,0,0,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26372C"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#4A4A4A"/>
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#353535"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F3F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3F3F3F"/>
                                <Setter Property="Foreground" Value="#6B6B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#353535"/>
                                <!-- Texto siempre visible sobre el resaltado -->
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A7A7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro: evita texto blanco/negro invisible sobre fondos del tema -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MaxDropDownHeight" Value="240"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Fondo/borde clicable con flecha -->
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="{DynamicResource InputBackgroundBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Texto del ítem seleccionado (siempre en color del tema) -->
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <!-- Popup con fondo oscuro sólido -->
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding MinWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4"
                                            SnapsToDevicePixels="True"/>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Color="#1F1F1F"/>
    </Window.Background>

    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>    <!-- Header -->
            <RowDefinition Height="Auto"/>    <!-- Tarjetas + Barra utilización -->
            <RowDefinition Height="*"/>       <!-- Menú lateral + contenido de la sección -->
            <RowDefinition Height="Auto"/>    <!-- Botones principales (siempre visibles) -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER (compacto) ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14,8" Background="{DynamicResource CardBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botón hamburguesa (esquina superior izquierda) -->
                <Button Grid.Column="0" x:Name="MenuButton"
                        Click="MenuButton_Click"
                        Width="38" Height="38"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Expandir o contraer menú"
                        AutomationProperties.Name="Expandir o contraer menú">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6" SnapsToDevicePixels="True">
                                <Viewbox Width="18" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="18" Height="14">
                                        <Rectangle Canvas.Top="0" Width="18" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextPrimaryBrush}"/>
                                        <Rectangle Canvas.Top="6" Width="18" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextPrimaryBrush}"/>
                                        <Rectangle Canvas.Top="12" Width="18" Height="2" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextPrimaryBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3A3A3A"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#454545"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Logo + Nombre -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="4" Margin="0,0,10,0">
                        <controls:RamEyeLogo HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Ram Tracking" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Consulta • Monitorea • Diagnostica" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Info del equipo -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemInfo.ComputerName, Converter={StaticResource NotAvailableTextConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemInfo.OperatingSystem, Converter={StaticResource NotAvailableTextConverter}}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ctrlPressed, Converter={StaticResource NotAvailableTextConverter}, StringFormat='Ctrl presionado: {0}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Modo alto contraste -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding highContrastMode, Converter={StaticResource NotAvailableTextConverter}, StringFormat='Modo Alto Contraste: {0}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding quickDiagnosticText, Converter={StaticResource NotAvailableTextConverter}, StringFormat='Diagnóstico: {0}'}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </StackPanel>

                <!-- CPU / Arquitectura -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SystemInfo.Processor, Converter={StaticResource NotAvailableTextConverter}}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Right"/>
                    <TextBlock Text="{Binding SystemInfo.Architecture, Converter={StaticResource NotAvailableTextConverter}}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TARJETAS DE MEMORIA + BARRA UTILIZACIÓN (Siempre visibles) ===== -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Tarjetas de memoria (4 columnas) -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="4,0">
                <ContentControl Content="{Binding MemoryCards[0]}" ContentTemplate="{StaticResource MemoryCardTemplate}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0">
                <ContentControl Content="{Binding MemoryCards[1]}" ContentTemplate="{StaticResource MemoryCardTemplate}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0">
                <ContentControl Content="{Binding MemoryCards[2]}" ContentTemplate="{StaticResource MemoryCardTemplate}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0">
                <ContentControl Content="{Binding MemoryCards[3]}" ContentTemplate="{StaticResource MemoryCardTemplate}"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Border>

            <!-- Barra de utilización + Semáforo (columna 5) -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Margin="4,0" Padding="20" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Utilización de memoria" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <Grid Grid.Row="1" Height="28" Margin="0,8,0,8">
                        <Border Background="#3F3F3F" CornerRadius="14" Height="28"/>
                        <Border Background="{Binding CurrentMemory.UsagePercent, Converter={StaticResource PercentToColorConverter}}"
                                CornerRadius="14" Height="28" HorizontalAlignment="Left">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                    <Binding Path="CurrentMemory.UsagePercent"/>
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <TextBlock Text="{Binding CurrentMemory.UsagePercent, Converter={StaticResource OptionalPercentTextConverter}}" 
                                   FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="14" Height="14" Margin="0,0,8,0"
                                 Fill="{Binding CurrentMemory.UsagePercent, Converter={StaticResource PercentToColorConverter}}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentMemory.UsagePercent, Converter={StaticResource PercentToStatusTextConverter}}"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== MENÚ LATERAL + CONTENIDO (sin TabControl) ===== -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú hamburguesa lateral izquierdo (62 px contraído / 210 px expandido) -->
            <Border x:Name="MenuPanel" Grid.Column="0"
                    Width="{Binding IsMenuExpanded, Converter={StaticResource MenuWidthConverter}}"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NAVEGACIÓN" Margin="16,14,8,4" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <ListBox Grid.Row="1" x:Name="MenuList"
                             SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                             SelectionChanged="MenuList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Padding="0,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource MenuItemStyle}">
                        <ListBoxItem ToolTip="Monitor" AutomationProperties.Name="Monitor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Width="24" TextAlignment="Center"/>
                                <TextBlock Text="Monitor" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Módulos" AutomationProperties.Name="Módulos">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔧" FontSize="16" Width="24" TextAlignment="Center"/>
                                <TextBlock Text="Módulos" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Diagnóstico" AutomationProperties.Name="Diagnóstico">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="16" Width="24" TextAlignment="Center"/>
                                <TextBlock Text="Diagnóstico" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Reporte" AutomationProperties.Name="Reporte">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="16" Width="24" TextAlignment="Center"/>
                                <TextBlock Text="Reporte" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem ToolTip="Acerca de" AutomationProperties.Name="Acerca de">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="16" Width="24" TextAlignment="Center"/>
                                <TextBlock Text="Acerca de" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="v1.0" Margin="16,4,8,12" FontSize="10" HorizontalAlignment="Left"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding IsMenuExpanded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Contenido de la sección activa -->
            <Grid x:Name="SectionHost" Grid.Column="1" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>

                <!-- SECCIÓN 1: MONITOR -->
                <Grid Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=0}">
                <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="0,8,8,8" Margin="0,4,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Gráfica de monitoreo -->
                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Historial de utilización (últimas 60 muestras, actualización cada 2s)" Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <!-- LiveCharts CartesianChart -->
                                <lvc:CartesianChart Grid.Row="1" x:Name="UsageChart" MinHeight="300"
                                                    Series="{Binding ChartSeries}"
                                                    XAxes="{Binding ChartXAxes}"
                                                    YAxes="{Binding ChartYAxes}"
                                                    LegendPosition="Bottom"
                                                    TooltipPosition="Top"
                                                    AnimationsSpeed="0:0:0.2"
                                                    Background="Transparent"/>

                                <!-- Sin muestras de monitoreo -->
                                <TextBlock Grid.Row="1" Text="No disponible"
                                           FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding Samples.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                                <!-- Stats min/max/avg -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="4" Background="{DynamicResource CardBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="MÍNIMO" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding MinUsage, Converter={StaticResource OptionalPercentTextConverter}}" FontSize="18" FontWeight="Bold" Foreground="#22C55E"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="4" Background="{DynamicResource CardBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="PROMEDIO" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding AvgUsage, Converter={StaticResource OptionalPercentTextConverter}}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="16,10" Margin="4" Background="{DynamicResource CardBackgroundBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="MÁXIMO" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                                <TextBlock Text="{Binding MaxUsage, Converter={StaticResource OptionalPercentTextConverter}}" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Ranking de programas por consumo de RAM (tiempo real) -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12" Background="{DynamicResource CardBackgroundBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Programas con mayor consumo de RAM (Top 10, actualización cada 2s)" Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProcesses}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='#{0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="4,0,8,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding UsedMiB, StringFormat='{}{0:F0} MiB'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                </Grid>

                                                <!-- Barra relativa al programa más consumidor -->
                                                <Grid Grid.Row="1" Height="6" Margin="34,4,0,0">
                                                    <Border Background="#3F3F3F" CornerRadius="3" Height="6"/>
                                                    <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="3" Height="6" HorizontalAlignment="Left">
                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                                                <Binding Path="RelativePercent"/>
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                 <!-- Mensaje si no hay datos -->
                                 <TextBlock Grid.Row="1"
                                            Text="No disponible"
                                            FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding TopProcesses.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                            </Grid>
                        </Border>

                        <!-- Controles de monitoreo -->
                    </Grid>
                </ScrollViewer>
                </Border>
                </Grid>

                <!-- SECCIÓN 2: MÓDULOS -->
                <Grid Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=1}">
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Módulos de memoria física detectados (vía SMBIOS/WMI) — haga clic en un slot para ver sus detalles" Style="{StaticResource SectionHeaderStyle}" Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <!-- SlotMap de módulos -->
                        <controls:SlotMap Grid.Row="1"
                                          ItemsSource="{Binding Modules}"
                                          SelectedModule="{Binding SelectedModule}"/>

                        <!-- Mensaje si no hay módulos -->
                        <TextBlock Grid.Row="1" 
                                   Text="No se detectaron módulos (No disponible)" 
                                   FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding Modules.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                        <!-- Panel de detalles del slot seleccionado -->
                        <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" CornerRadius="8"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedModule}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Encabezado del panel -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                           Text="{Binding SelectedModule.BankDisplay, StringFormat='Detalles del slot:  {0}'}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,10"/>

                                <!-- Columna izquierda -->
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Posición física del slot" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding SlotDetail.DeviceLocator, Converter={StaticResource NotAvailableTextConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Text="Capacidad máxima total del banco (SMBIOS)" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SlotDetail.ArrayMaxCapacityGiB, Converter={StaticResource OptionalGiBConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Suma de todos los slots del banco" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="Capacidad máxima por slot instalado" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SlotDetail.PerSlotCapacityGiB, Converter={StaticResource OptionalGiBConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SlotDetail.SlotsInArray, Converter={StaticResource OptionalSlotsConverter}}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="Voltaje de operación" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SlotDetail.MinVoltage, Converter={StaticResource OptionalVoltageConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text=" – " FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding SlotDetail.MaxVoltage, Converter={StaticResource OptionalVoltageConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="Configurado: " FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        <TextBlock Text="{Binding SlotDetail.ConfiguredVoltage, Converter={StaticResource OptionalVoltageConverter}}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Columna derecha -->
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Tipo de RAM soportado por el slot" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock Text="{Binding SlotDetail.SupportedType, Converter={StaticResource NotAvailableTextConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="(según el módulo instalado; el slot solo admite esa generación)" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="Detalles del tipo de memoria" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SlotDetail.TypeDetail, Converter={StaticResource NotAvailableTextConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                    <TextBlock Text="Corrección de errores del banco" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SlotDetail.ArrayErrorCorrection, Converter={StaticResource NotAvailableTextConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>

                                    <TextBlock Text="Uso del banco" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
                                    <TextBlock Text="{Binding SlotDetail.ArrayUse, Converter={StaticResource NotAvailableTextConverter}}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                </Grid>

                <!-- SECCIÓN 3: DIAGNÓSTICO -->
                <Grid Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=2}">
                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Diagnóstico y prueba de memoria" Style="{StaticResource SectionHeaderStyle}" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- Texto explicativo -->
                            <Border Background="#1E3A2F" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,12,0,0">
                                <TextBlock Text="{Binding DiagnosticText}" 
                                           FontSize="14" Foreground="#4ADE80" 
                                           TextWrapping="Wrap" LineHeight="24"/>
                            </Border>

                            <!-- Observaciones manuales -->
                            <StackPanel Margin="0,24,0,0">
                                <TextBlock Text="📝 Observaciones del usuario" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Registre aquí el resultado de la prueba de memoria de Windows (mdsched.exe) u otras notas:" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding ManualObservation, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="120" Padding="12"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         FontSize="14"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Estado prueba -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                <TextBlock Text="Estado de la prueba de memoria:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding MemoryTestStatusOptions}"
                                          SelectedItem="{Binding MemoryTestStatus}"
                                          Width="220" Margin="12,0,0,0" VerticalAlignment="Center"
                                          Style="{StaticResource DarkComboBoxStyle}"/>
                                <Button Content="🔍 Detectar resultado automáticamente" 
                                        Command="{Binding CheckMemoryTestResultCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="12,0,0,0" Padding="16,8" FontSize="13"/>
                                <Button Content="📋 Copiar instrucciones" 
                                        Command="{Binding CopyDiagnosticCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="12,0,0,0" Padding="16,8" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>

                <!-- SECCIÓN 4: REPORTE -->
                <Grid Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=3}">
                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="Generar reporte de diagnóstico" Style="{StaticResource SectionHeaderStyle}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="El reporte incluirá:" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,12" TextAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Información del equipo y fecha/hora" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Memoria instalada, utilizable, en uso, disponible y %" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Detalle de módulos detectados (fabricante, parte, tipo, MT/s)" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Estadísticas de monitoreo (mín, máx, promedio)" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Top 10 programas que más RAM consumieron durante el monitoreo" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Estado de la prueba de memoria y observaciones" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <Button Content="📄 Generar reporte TXT"
                                    Command="{Binding GenerateReportCommand}"
                                    CommandParameter="txt"
                                    Style="{StaticResource ActionButtonStyle}"
                                    MinWidth="220" Height="52"
                                    FontSize="15"/>
                            <Button Content="📊 Generar reporte CSV"
                                    Command="{Binding GenerateReportCommand}"
                                    CommandParameter="csv"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="220" Height="52"
                                    Margin="16,0,0,0"
                                    FontSize="15"/>
                        </StackPanel>

                        <TextBlock Text="Se abrirá un diálogo para elegir ubicación y nombre del archivo." 
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                </Grid>

                <!-- SECCIÓN 5: ACERCA DE -->
                <Grid Visibility="{Binding SelectedSectionIndex, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=4}">
                <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,4,0,0" Background="{DynamicResource CardBackgroundBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="700">
                            <controls:RamEyeLogo Width="88" Height="88" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                            <TextBlock Text="Acerca de Ram Tracking" Style="{StaticResource SectionHeaderStyle}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            
                            <Border Background="#E3F2FD" BorderBrush="#2196F3" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Especificaciones del Programa" FontSize="16" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Nombre de la aplicación:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Ram Tracking" FontSize="13" Foreground="#424242" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Descripción:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Aplicación de escritorio para consultar, monitorear y documentar el estado de la memoria RAM." FontSize="13" Foreground="#424242" Margin="8,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Plataforma:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Windows 10 / 11" FontSize="13" Foreground="#424242" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Tecnología:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text=".NET 10 / WPF" FontSize="13" Foreground="#424242" Margin="8,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#F3E5F5" BorderBrush="#9C27B0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Datos Académicos" FontSize="16" FontWeight="SemiBold" Foreground="#6A1B9A" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Asignatura:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Organización y arquitectura de computadoras" FontSize="13" Foreground="#424242" Margin="8,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Actividad:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Laboratorio: desarrollo de una app para el diagnóstico de memoria RAM" FontSize="13" Foreground="#424242" Margin="8,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Modalidad:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Individual" FontSize="13" Foreground="#424242" Margin="8,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Elaborado por" FontSize="16" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,12"/>
                                    <StackPanel Margin="0,4,0,4">
                                        <TextBlock Text="Estudiante:" FontSize="13" FontWeight="SemiBold" Foreground="#333333"/>
                                        <TextBlock Text="Miguel Aparicio" FontSize="15" FontWeight="Medium" Foreground="#424242" Margin="8,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="© 2026 - Ram Tracking | Laboratorio de Organización y Arquitectura de Computadoras" 
                                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,24,0,0" 
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== BOTONES PRINCIPALES (siempre visibles en la parte inferior) ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="{Binding IsMonitoring, Converter={StaticResource BoolToMonitorButtonTextConverter}}"
                    Command="{Binding ToggleMonitoringCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="200" Height="50"
                    FontSize="15" FontWeight="SemiBold"/>
            <Button Content="📄 Generar reporte"
                    Command="{Binding GenerateReportCommand}"
                    Style="{StaticResource ActionButtonStyle}"
                    MinWidth="200" Height="50"
                    Margin="16,0,0,0"
                    FontSize="15" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>